[Unit]
Description=Recover Guardian-aware Ubuntu update and reboot activation
Wants=network-online.target docker.service
After=network-online.target docker.service containerd.service
Before=vps-ubuntu-update.timer vps-docker-update.timer guardian-image-update.timer vps-docker-update.service guardian-image-update.service
RequiresMountsFor=/var/lib/vps-ubuntu-update /var/backups/mail-guardian/pilot /etc/mail-guardian/pilot

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -I /opt/vps-maintenance/security-maintenance/simple-updates/ubuntu/updater.py --recover
TimeoutStartSec=3h
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
