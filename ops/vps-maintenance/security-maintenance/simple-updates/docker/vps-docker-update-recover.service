[Unit]
Description=Recover an interrupted Docker update using current Guardian state
After=vps-docker-update.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/vps-maintenance/security-maintenance/simple-updates/docker/updater.py --recover
TimeoutStartSec=3h
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
