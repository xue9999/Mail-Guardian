[Unit]
Description=Update Guardian container images
Wants=network-online.target
After=network-online.target docker.service
OnFailure=guardian-image-update-recover.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -I /opt/vps-maintenance/security-maintenance/simple-updates/guardian_images.py
TimeoutStartSec=45min
KillMode=control-group
StandardOutput=journal
StandardError=journal
